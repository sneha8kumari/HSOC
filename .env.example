# H-SOC — Environment Variables Template
# Copy this file to .env and configure for your environment.
# Never commit .env containing production secrets to version control.

# ── API & Authentication ───────────────────────────────────────────────────────
# Optional bearer token for REST API endpoints. Leave blank to disable auth in dev.
API_TOKEN=

# ── Database & Persistence ─────────────────────────────────────────────────────
# SQLite WAL mode is enabled automatically for high-concurrency event ingestion.
DATABASE_URL=sqlite:///./data/hsoc.db

# ── AI Copilot Provider (Ollama Local or Hosted) ──────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional hosted LLM provider (OpenAI-compatible / Mistral / DeepSeek)
HOSTED_LLM_BASE_URL=https://api.mistral.ai/v1
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=mistral-medium

# ── Hybrid Knowledge Retrieval & RAG ───────────────────────────────────────────
KB_DIR=data/kb
NVD_API_KEY=
NVD_CVE_LIST=CVE-2011-2523,CVE-2014-6271,CVE-2017-5638

# ── Wazuh Security Events Live Integration ─────────────────────────────────────
# Wazuh Manager API endpoint (default port 55000)
WAZUH_URL=https://127.0.0.1:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=
WAZUH_VERIFY_SSL=false
# Shared secret for authenticating Wazuh alert forwarder webhooks:
# Set this secret in Wazuh ossec.conf <integration> and pass via X-Wazuh-Secret header
WAZUH_WEBHOOK_SECRET=your_wazuh_webhook_secret_here

# ── Windows Laptop Telemetry Integration ──────────────────────────────────────
# Collects native Security/System/Application Event Logs and active TCP connection metadata
WINDOWS_COLLECTOR_ENABLED=true
WINDOWS_POLL_INTERVAL=10.0
WINDOWS_CHANNELS=Security,System,Application
WINDOWS_COLLECT_NETWORK=true
WINDOWS_MAX_BUFFER=5000

# ── Real-Time Streaming & Complex Event Processing (CEP) ───────────────────────
STREAM_PIPELINE_AUTORUN=true
EVENT_BUS_TYPE=asyncio
REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
